---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../lib/posts.js';

const SITE = 'https://www.toppertube.online';
const posts = getPosts();
const [featured, ...rest] = posts;
const ld = [
  { '@type': 'Blog', '@id': SITE + '/blog#blog', url: SITE + '/blog', name: 'Toppertube Blog', description: 'Practical guides on learning, studying, note-taking, memory and productivity.', publisher: { '@id': SITE + '/#org' },
    blogPost: posts.map(p => ({ '@type': 'BlogPosting', headline: p.title, url: `${SITE}/blog/${p.slug}`, datePublished: p.date })) },
  { '@type': 'Organization', '@id': SITE + '/#org', name: 'Toppertube', url: SITE + '/', logo: { '@type': 'ImageObject', url: SITE + '/favicon-512.png', width: 512, height: 512 } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + '/blog' }] }
];
---
<Base
  title="Toppertube Blog – Study Tips, Productivity & Learning Guides"
  description="Practical guides on learning faster, taking better notes, remembering what you study and building study habits that last. Free, from the Toppertube team."
  path="/blog"
  jsonLd={ld}
>
  <section class="bhero">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Study smarter. Learn for life.</h1>
      <p class="lead">Clear, practical guides on learning from video, taking notes, remembering what you study and building habits that keep you going.</p>
    </div>
  </section>

  <section class="blist">
    <div class="wrap">
      {featured && (
        <a class="feat" href={`/blog/${featured.slug}`}>
          <span class="tagline">Featured · {fmtDate(featured.date)} · {featured.minutes} min read</span>
          <h2>{featured.title}</h2>
          <p>{featured.description}</p>
          <span class="rd">Read the guide →</span>
        </a>
      )}
      <ul class="grid bgrid">
        {rest.map(p => (
          <li>
            <a class="card bpost" href={`/blog/${p.slug}`}>
              <small>{fmtDate(p.date)} · {p.minutes} min read</small>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <span class="rd">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="bcta">
        <h2>Put it into practice for free</h2>
        <p>Turn any YouTube playlist into a course with notes, progress tracking and a certificate.</p>
        <a class="btn white" href="/start">Start learning free</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
.bhero{padding:clamp(32px,6vw,72px) 0 8px;background:radial-gradient(800px 320px at 90% -20%,var(--tint),transparent 70%)}
.blist{padding-top:28px}
.feat{display:block;padding:clamp(22px,4vw,40px);border:1px solid var(--line);border-radius:24px;background:var(--card);color:var(--ink);text-decoration:none;box-shadow:var(--shadow);margin-bottom:22px;transition:transform .15s,border-color .15s}
.feat:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--brand) 45%,var(--line))}
.feat h2{margin:10px 0;font-size:clamp(1.5rem,1.1rem + 1.8vw,2.3rem)}.feat p{margin:0 0 14px;color:var(--mut);max-width:62ch}
.tagline{font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--link)}
.rd{font-weight:700;color:var(--link)}
.bgrid{grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr))}
.bpost small{color:var(--mut);font-size:13px}.bpost h3{margin:8px 0;font-size:1.2rem}.bpost p{margin-bottom:12px}
.bcta{margin-top:40px;text-align:center;padding:clamp(26px,5vw,48px);border-radius:24px;background:linear-gradient(135deg,#d62839,#ff6b4a);color:#fff}
.bcta h2{color:#fff;margin:0 0 8px}.bcta p{margin:0 auto 20px;max-width:46ch;opacity:.95}.btn.white{background:#fff;color:#b3162a;box-shadow:none}
</style>
