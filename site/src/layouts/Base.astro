---
// One page frame for the landing page and the blog: head tags for search engines and sharing, header, footer and the shared styles.
const { title, description, path = '/', ogType = 'website', jsonLd = [], published = '', modified = '' } = Astro.props;
const SITE = 'https://www.toppertube.online';
const url = SITE + (path === '/' ? '/' : path);
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Toppertube" />
  <meta property="og:locale" content="en" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={SITE + '/og-image.png'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={SITE + '/og-image.png'} />
  <meta name="theme-color" content="#d62839" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Toppertube for AI assistants" />
  <script type="application/ld+json" set:html={ld}></script>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="hd">
    <div class="wrap hd-in">
      <a class="logo" href="/">Topper<b>Tube</b></a>
      <nav class="nav" aria-label="Main">
        <a href="/#subjects">Subjects</a>
        <a href="/#how">How it works</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a class="go" href="/start">Start learning</a>
      </nav>
    </div>
  </header>
  <main id="content"><slot /></main>
  <footer class="ft">
    <div class="wrap ft-in">
      <div>
        <a class="logo" href="/">Topper<b>Tube</b></a>
        <p>Free learning videos, courses, notes and certificates from trusted YouTube channels. Videos belong to their creators and play from YouTube.</p>
      </div>
      <nav aria-label="Footer">
        <a href="/categories">All subjects</a>
        <a href="/free-online-courses">Free online courses</a>
        <a href="/free-education">Free education</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/start">Open the app</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style is:global>
:root{--bg:#fafaf8;--card:#fff;--ink:#14141a;--mut:#5d6068;--line:#e7e7e1;--brand:#d62839;--brand2:#ff6b4a;--link:#b3162a;--tint:rgba(214,40,57,.08);--shadow:0 1px 2px rgba(20,20,26,.05),0 10px 30px rgba(20,20,26,.07);color-scheme:light dark}
@media(prefers-color-scheme:dark){:root{--bg:#0e1014;--card:#171a21;--ink:#f3f3f5;--mut:#a4a8b2;--line:#272b35;--link:#ff8a97;--tint:rgba(255,107,122,.10);--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35)}}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;font:16px/1.65 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",sans-serif;background:var(--bg);color:var(--ink);padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right)}
a{color:var(--link);text-underline-offset:3px}a:focus-visible{outline:3px solid var(--brand);outline-offset:3px;border-radius:8px}
img{max-width:100%;height:auto}
.skip{position:absolute;left:-999px;top:8px;background:var(--brand);color:#fff;padding:8px 14px;border-radius:8px;z-index:50}.skip:focus{left:8px}
.wrap{max-width:1120px;margin:0 auto;padding:0 clamp(16px,3vw,28px)}
.hd{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 86%,transparent);-webkit-backdrop-filter:saturate(1.4) blur(12px);backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top)}
.hd-in{display:flex;align-items:center;gap:8px 18px;flex-wrap:wrap;padding-top:10px;padding-bottom:10px}
.logo{font-weight:800;font-size:22px;letter-spacing:-.02em;color:var(--ink);text-decoration:none}.logo b{color:var(--brand)}
.nav{display:flex;gap:4px;margin-left:auto;align-items:center}
.nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:15px;padding:8px 13px;border-radius:999px;transition:background .15s}
.nav a:hover{background:var(--tint)}.nav a.go{background:var(--brand);color:#fff;margin-left:6px}.nav a.go:hover{filter:brightness(1.08)}
@media(max-width:700px){.nav{order:3;width:100%;margin-left:0;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}.nav::-webkit-scrollbar{display:none}.nav a{white-space:nowrap;padding:8px 11px;font-size:14px}.nav a.go{margin-left:auto}}
h1,h2,h3{letter-spacing:-.02em;line-height:1.15}
h1{font-size:clamp(2rem,1.2rem + 3.8vw,3.6rem);margin:0 0 .4em}
h2{font-size:clamp(1.5rem,1.1rem + 1.6vw,2.2rem);margin:0 0 .5em}h3{font-size:1.1rem;margin:0 0 .35em}
.eyebrow{display:inline-block;margin:0 0 12px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--link)}
.lead{font-size:clamp(1.05rem,.95rem + .45vw,1.25rem);color:var(--mut);max-width:60ch;margin:0 0 1.4em}
.btns{display:flex;gap:10px;flex-wrap:wrap}
.btn,.btn2{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border-radius:999px;font-weight:700;text-decoration:none;transition:transform .15s,filter .15s,border-color .15s}
.btn{background:var(--brand);color:#fff;box-shadow:0 8px 22px rgba(214,40,57,.3)}.btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
.btn2{border:1px solid var(--line);background:var(--card);color:var(--ink)}.btn2:hover{border-color:var(--brand);color:var(--link)}
section{padding:clamp(40px,7vw,84px) 0}
.sec-head{max-width:62ch;margin-bottom:28px}.sec-head p{color:var(--mut);margin:0}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));list-style:none;margin:0;padding:0}
.card{display:block;height:100%;padding:20px;border:1px solid var(--line);border-radius:18px;background:var(--card);color:var(--ink);text-decoration:none;transition:transform .15s,box-shadow .15s,border-color .15s}
a.card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:color-mix(in srgb,var(--brand) 45%,var(--line))}
.card p{margin:0;color:var(--mut);font-size:15px}.ic{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:var(--tint);font-size:23px;margin-bottom:14px}
.ft{border-top:1px solid var(--line);padding:36px 0 calc(36px + env(safe-area-inset-bottom));color:var(--mut);font-size:14.5px}
.ft-in{display:flex;gap:24px 56px;flex-wrap:wrap;justify-content:space-between}.ft p{margin:10px 0 0;max-width:46ch}.ft nav{display:flex;gap:8px 22px;flex-wrap:wrap;align-content:flex-start;max-width:420px}.ft nav a{color:var(--mut)}.ft nav a:hover{color:var(--link)}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
